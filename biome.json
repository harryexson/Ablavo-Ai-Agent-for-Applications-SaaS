{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": { "ignore": ["**/node_modules", "**/dist", "**/.next", "**/drizzle/meta", ".data", "**/next-env.d.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "useTemplate": "off" },
      "suspicious": { "noExplicitAny": "warn" },
      "a11y": { "useButtonType": "off" },
      "complexity": { "noForEach": "off" }
    }
  }
}
