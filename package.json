{
  "name": "ablavo",
  "private": true,
  "version": "0.1.0",
  "description": "Ablavo — AI onboarding, implementation, training and in-app assistance as a service.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @ablavo/api dev",
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx tests/evals/run-evals.ts",
    "db:generate": "pnpm --filter @ablavo/database generate",
    "seed": "tsx scripts/seed-demo.ts",
    "widget:build": "pnpm --filter @ablavo/widget build",
    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
