# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
# Landing site and console share one domain; the console is served at /console
MARKETING_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000/console
# Neon Postgres in production (pgvector required). Leave empty locally to use embedded Postgres.
DATABASE_URL=
# 32 random bytes, base64 — required in production
ENCRYPTION_KEY=
# Optional: .yourdomain.com to share sign-in across subdomains
COOKIE_DOMAIN=
SUPERADMIN_EMAILS=
REDIS_URL=
# AI providers (optional; the built-in grounded model works without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=local
# Stripe — run `pnpm stripe:setup` once with the secret key
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Email (Resend). Without it, dev shows verification/reset links in the UI.
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
SALES_EMAIL=sales@example.com
# Object storage (Cloudflare R2 / S3). Empty = local disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Written by `pnpm seed`
DEMO_APP_ID=

# ---------- Landing site (apps/marketing) ----------
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CONSOLE_URL=http://localhost:3001

# ---------- Console (apps/developer-portal) ----------
# API_URL=http://localhost:4000
